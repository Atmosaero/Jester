{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder Project/ShaderLib": { "watch": "@PROJECTROOT@/ShaderLib", "recursive": 1, "order": 1 },
                "ScanFolder Project/Assets": { "watch": "@PROJECTROOT@/Assets", "recursive": 1, "order": 2 },
                "ScanFolder Project/Registry": { "watch": "@PROJECTROOT@/Registry", "recursive": 1, "order": 3 },
                "ScanFolder DiffuseProbeGrid": { "watch": "@ENGINEROOT@/Gems/DiffuseProbeGrid/Assets", "recursive": 1, "order": 150 },
                "ProjectRelativeGemsScanFolderPriority": "higher",
                "Jobs": { "minJobs": 1, "maxJobs": 3 },
                "Exclude unused SDK lighting samples": { "glob": "LightingPresets/*" },
                "Exclude unused SDK model samples": { "glob": "Objects/Hermanubis/*" },
                "Exclude Jester editor sources": { "glob": "Editor/*" },
                "Exclude Jester native application": { "glob": "App/*" },
                "Exclude Jester evidence": { "glob": "artifacts/*" }
            }
        }
    }
}
