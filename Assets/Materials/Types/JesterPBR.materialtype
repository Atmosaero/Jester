                    },
                    {
                        "name": "OcclusionRow1",
                        "type": "Vector4",
                        "defaultValue": [
                            0,
                            1,
                            0,
                            0
                        ],
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_jesterOcclusionRow1"
                        }
                    },
                    {
                        "name": "OcclusionSampler",
                        "type": "SamplerState",
                        "defaultValue": {
                            "m_filterMin": "Linear",
                            "m_filterMag": "Linear",
                            "m_filterMip": "Linear",
                            "m_addressU": "Wrap",
                            "m_addressV": "Wrap"
                        },
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_jesterOcclusionSampler"
