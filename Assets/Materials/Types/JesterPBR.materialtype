                        "defaultValue": [
                            0,
                            1,
                            0,
                            0
                        ],
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_jesterMetallicRoughnessRow1"
                        }
                    },
                    {
                        "name": "MetallicRoughnessSampler",
                        "type": "SamplerState",
                        "defaultValue": {
                            "m_filterMin": "Linear",
                            "m_filterMag": "Linear",
                            "m_filterMip": "Linear",
                            "m_addressU": "Wrap",
