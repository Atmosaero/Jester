    },
    "lightingModel": "Standard",
    "materialShaderDefines": "JesterPBR_Defines.azsli",
    "materialShaderCode": "JesterPBR.azsli",
    "functors": [],
    "uvNameMap": {
        "UV0": "Tiled",
        "UV1": "Unwrapped"
    }
}
